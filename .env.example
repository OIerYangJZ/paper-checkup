# 复制为 .env 并填写（.env 已在 .gitignore 中，不会被提交）。
# ---------------------------------------------------------------
# 默认：OpenAI 兼容接口（OpenAI / DeepSeek / 通义千问 / Moonshot / 本地 vLLM 等）
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-...
# 不填则为 OpenAI 官方。示例：
#   DeepSeek:   https://api.deepseek.com/v1          LLM_MODEL=deepseek-chat
#   通义千问:    https://dashscope.aliyuncs.com/compatible-mode/v1   LLM_MODEL=qwen-max
#   Moonshot:   https://api.moonshot.cn/v1            LLM_MODEL=moonshot-v1-128k
OPENAI_BASE_URL=
LLM_MODEL=gpt-6.2-astra
# json_object（默认，兼容面最广）| json_schema（OpenAI 官方支持严格结构化输出）| none（推理模型等不支持 JSON 模式时）
LLM_JSON_MODE=json_schema
# 推理模型可选：low | medium | high
LLM_REASONING_EFFORT=high
# Chat Completions 上推理模型使用 max_completion_tokens（推理 token 也计入上限）
LLM_MAX_TOKENS_PARAM=max_completion_tokens

# ---------------------------------------------------------------
# 其他 OpenAI 兼容服务：各用自己的 key 变量，可以和上面的 OpenAI key 同时保留。
# 切换只需改 LLM_MODEL（“提供方:模型”），例如：
#   LLM_MODEL=deepseek:deepseek-v4-pro      （或 deepseek:deepseek-flash，更便宜）
#   LLM_MODEL=openai:gpt-6.2-astra
# 地址、JSON 模式、输出上限参数会按提供方自动设置；也可用 DEEPSEEK_BASE_URL / DEEPSEEK_JSON_MODE /
# DEEPSEEK_REASONING_EFFORT（low|high|max）等单独覆盖。
DEEPSEEK_API_KEY=
# DASHSCOPE_API_KEY=      # 通义千问：LLM_MODEL=qwen:qwen-max
# MOONSHOT_API_KEY=       # Kimi：LLM_MODEL=moonshot:kimi-latest

# ---------------------------------------------------------------
# 可选：改用 Claude（Anthropic 官方 SDK）
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# LLM_MODEL=claude-opus-5-5
# LLM_EFFORT=high

# ---------------------------------------------------------------
# 可选：按角色指定模型（格式 "model" 或 "provider:model"），例如让审稿人用另一家的模型以减少“自我认同”
# LLM_MODEL_EXTRACT=deepseek:deepseek-flash
# LLM_MODEL_AUTHOR=deepseek:deepseek-v4-pro
# LLM_MODEL_REVIEWER=openai:gpt-6.2-astra

# 其他
LLM_CONCURRENCY=4
LLM_MAX_TOKENS=64000
REVIEW_MAX_TARGETS=30
OUTPUT_LANG=zh
